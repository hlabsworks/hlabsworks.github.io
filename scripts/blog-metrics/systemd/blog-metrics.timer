[Unit]
Description=blog-metrics: run-daily.sh を1日3回起動するタイマー

[Timer]
# JST 07:30 / 12:30 / 19:30（Pi のシステムタイムゾーンがJSTである前提。異なる場合は
# タイムゾーン付きで指定するか、OnCalendar=*-*-* 22:30,03:30,10:30 UTC のようにUTC換算する）。
OnCalendar=*-*-* 07:30,12:30,19:30
# 1日3回のうち取りこぼしがあっても、次回起動時に積み残しとして実行する
# （run-daily.sh 自身は当日分を再計算するだけで、取りこぼし回数分を多重実行はしない）。
Persistent=true
Unit=blog-metrics.service

[Install]
WantedBy=timers.target
